# Copie para .env e ajuste se precisar (o .env nao e versionado).
# Valores abaixo sao apenas de DESENVOLVIMENTO; nunca use senhas reais aqui.

# ---- PostgreSQL (servico "db") ----
POSTGRES_DB=gestor_academico
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# A API monta DATABASE_URL a partir dos tres valores acima, usando o host "db"
# (nome do servico na rede do Compose). Senha com caracteres especiais
# (@ : / #) precisa ser codificada para URL.

# ---- Portas publicadas no computador ----
API_PORT=8000
FRONTEND_PORT=5173

# ---- Frontend ----
# URL da API usada pelo NAVEGADOR (vai para o JavaScript: nunca coloque segredos).
# Padrao "/api": o servidor do frontend repassa para a API pela rede do Compose.
# VITE_API_URL=/api
# Para chamar a API direto (sem o repasse), use a porta publicada e libere a
# origem do frontend em CORS_ORIGINS:
# VITE_API_URL=http://localhost:8000

# ---- Backend ----
# Origens do navegador autorizadas a chamar a API diretamente (lista separada
# por virgula). Por padrao o compose deriva da FRONTEND_PORT.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
